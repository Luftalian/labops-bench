{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:labops:action:v2",
  "title": "LabOpsBench v2 action (semantic constraints enforced by environment)",
  "type": "object",
  "required": ["state_version", "type"],
  "properties": {
    "state_version": {"type": "integer", "minimum": 0},
    "type": {"enum": ["validate_layout", "set_layout", "start", "dispatch", "wait", "relocate", "stop"]},
    "layout": {"$ref": "#/$defs/layout"},
    "device_id": {"type": "string"},
    "operations": {"type": "array", "minItems": 1, "maxItems": 9, "items": {"type": "object", "required": ["job_id", "node_id"], "properties": {"job_id": {"type": "string"}, "node_id": {"type": "string"}}, "additionalProperties": false}},
    "until_s": {"type": "number", "exclusiveMinimum": 0},
    "reason": {"type": "string", "maxLength": 1000},
    "x": {"type": "number"}, "y": {"type": "number"}, "rotation": {"enum": [0,90,180,270]},
    "input_robot_id": {"type": "string"}, "output_robot_id": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"enum": ["set_layout", "validate_layout"]}}}, "then": {"required": ["layout"]}},
    {"if": {"properties": {"type": {"const": "dispatch"}}}, "then": {"required": ["device_id", "operations"]}},
    {"if": {"properties": {"type": {"const": "relocate"}}}, "then": {"required": ["device_id"]}}
  ],
  "additionalProperties": false,
  "$defs": {
    "layout": {"type": "object", "required": ["devices", "robots"], "properties": {
      "robots": {"type": "array", "maxItems": 32, "items": {"type": "object", "required": ["id", "x", "y"], "properties": {"id": {"type": "string"}, "x": {"type": "number"}, "y": {"type": "number"}, "yaw": {"enum": [0,90,180,270]}}, "additionalProperties": false}},
      "devices": {"type": "array", "maxItems": 64, "items": {"type": "object", "required": ["id", "model", "x", "y", "rotation", "input_robot_id", "output_robot_id"], "properties": {"id": {"type": "string"}, "model": {"type": "string"}, "x": {"type": "number"}, "y": {"type": "number"}, "rotation": {"enum": [0,90,180,270]}, "input_robot_id": {"type": "string"}, "output_robot_id": {"type": "string"}}, "additionalProperties": false}}
    }, "additionalProperties": false}
  }
}
